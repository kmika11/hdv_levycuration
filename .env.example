# Copy this file to .env and fill in real values.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. This template is committed; never put real tokens here.

# --- Harvard Dataverse (production) ---
DATAVERSE_URL=https://dataverse.harvard.edu
DATAVERSE_API_TOKEN=

# --- Demo installation (for testing deposits before the real thing) ---
DEMO_DATAVERSE_URL=https://demo.dataverse.org
DEMO_DATAVERSE_API_TOKEN=

# Which target the pipeline uses: "harvard" or "demo"
DATAVERSE_TARGET=demo
