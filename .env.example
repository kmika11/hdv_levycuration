# Copy this file to .env and fill in real values.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. This template is committed; never put real tokens here.

# --- Harvard Dataverse (production) ---
DATAVERSE_URL=https://dataverse.harvard.edu
DATAVERSE_API_TOKEN=

# --- Demo installation (for testing deposits before the real thing) ---
DEMO_DATAVERSE_URL=https://demo.dataverse.org
DEMO_DATAVERSE_API_TOKEN=

# Which target the pipeline uses: "harvard" or "demo"
DATAVERSE_TARGET=demo

# --- Machine / network settings ---
# These describe your machine, not any particular batch, so they live here
# rather than in a committed config. A batch config may still override them.

# Disable TLS certificate verification for the whole process. Needed only to
# get past HUIT's rate limiter, and ONLY effective on the Harvard VPN.
# Off-VPN this weakens security and gains you nothing. Leave false by default.
DATAVERSE_INSECURE_SSL=false

# Concurrent file uploads per dataset. Keep low against Harvard.
DATAVERSE_N_PARALLEL=2

# Seconds to wait between datasets, to stay under the rate limiter.
DATAVERSE_SLEEP_BETWEEN_DATASETS=300
